@model Project6.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<h2>Edit Movie Details</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MovieId" /> <!-- Critical for EF Core to track -->

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="CategoryID">Category</label>
        <select asp-for="CategoryID" class="form-control" asp-items="@(new SelectList(ViewBag.Categories, "CategoryID", "CategoryName", Model.CategoryID))">
            <option value="">-- Select Category --</option>
        </select>
    </div>


    <div class="form-group">
        <label asp-for="Year"></label>
        <input asp-for="Year" type="number" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Rating"></label>
        <select asp-for="Rating" class="form-control">
            <option>G</option>
            <option>PG</option>
            <option>PG-13</option>
            <option>R</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Edited">Edited?</label>
        <input type="checkbox" asp-for="Edited" />
    </div>

    <div class="form-group">
        <label asp-for="LentTo"></label>
        <input asp-for="LentTo" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CopiedToPlex">Copied to Plex?</label>
        <input type="checkbox" asp-for="CopiedToPlex" />
    </div>

    <div class="form-group">
        <label asp-for="Notes">Notes (max 25 chars)</label>
        <input asp-for="Notes" class="form-control" maxlength="25" />
    </div>

    <button type="submit" class="btn btn-success mt-3">💾 Save Changes</button>
    <a asp-action="WaitList" class="btn btn-secondary mt-3">🔙 Cancel</a>
</form>
