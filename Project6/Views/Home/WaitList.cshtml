@model List<Project6.Models.Movie>

@{
    ViewData["Title"] = "Movie Collection Waitlist";
}

<h2 class="text-center mt-4">🎥 Joel Hilton Film Collection - Movie Waitlist</h2>

<table class="table table-striped table-bordered mt-4">
    <thead class="table-dark">
    <tr>
        <th>Category</th>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>Lent To</th>
        <th>Copied To Plex</th>
        <th>Notes</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@(x.Category?.CategoryName ?? "Miscellaneous")</td>
            <td>@(x.Title ?? "Untitled")</td>
            <td>@x.Year</td>
            <td>@(x.Director ?? "Unknown")</td>
            <td>@(x.Rating ?? "Not Rated")</td>
            <td>@(x.Edited ? "Yes" : "No")</td>
            <td>@(x.LentTo ?? "None")</td>
            <td>@(x.CopiedToPlex ? "Yes" : "No")</td>
            <td>@(x.Notes ?? "")</td>

            <td>
                <a class="btn btn-warning btn-sm" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@x.MovieId">🗑️ Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>